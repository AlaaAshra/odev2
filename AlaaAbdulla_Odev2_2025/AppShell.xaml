<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:AlaaAbdulla_Odev2_2025"
       x:Class="AlaaAbdulla_Odev2_2025.AppShell"
       FlyoutBehavior="Flyout"
       BackgroundColor="#866133"
       TitleColor="White">


    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#BFA174" Padding="10, 20">
            <Label Text="Menü"
                   TextColor="White"
                   FontSize="Large"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"/>
        </Grid>
    </Shell.FlyoutHeader>


    <FlyoutItem Title="Ana Sayfa" Icon="home1.png">
        <ShellContent ContentTemplate="{DataTemplate local:AnaSayfa}" />
    </FlyoutItem>
    <FlyoutItem Title="Kredi Hesaplama" Icon="payments.png">
        <ShellContent ContentTemplate="{DataTemplate local:KrediHesaplama}" />
    </FlyoutItem>
    <FlyoutItem Title="Vucut Kitle Indexi" Icon="healthcare.png">
        <ShellContent ContentTemplate="{DataTemplate local:VucutKitleIndexi}" />
    </FlyoutItem>
    <FlyoutItem Title="Renk Secici" Icon="colors.png">
        <ShellContent ContentTemplate="{DataTemplate local:RenkSecici}" />
    </FlyoutItem>


</Shell>
